[{% for post in site.posts limit: 3 %}
  {"title": {{ post.title | jsonify }}, "summary": {{ post.summary | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: "%d %b %Y" | jsonify }}, "cover": {{ post.cover | relative_url | jsonify }}, "icon": {{ post.icon | default: "💡" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
]
